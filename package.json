{
  "name": "access-desk",
  "version": "1.4.0",
  "private": true,
  "description": "Grants and revokes staff access to work tools when people join, move and leave.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "tsc -p . && node dist/src/server.js",
    "test": "tsc -p . && node --test \"dist/test/*.test.js\"",
    "import": "tsc -p . && node dist/scripts/import.js",
    "stale-access": "tsc -p . && node dist/scripts/stale-access.js",
    "seed:generate": "tsc -p . && node dist/scripts/generate-seed.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "4.22.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
